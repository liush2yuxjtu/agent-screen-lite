{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "agent-screen-lite": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "${PLUGIN_ROOT}/../mcp-server/server.py"
      ],
      "cwd": "${PLUGIN_ROOT}/..",
      "env": {
        "AGENT_SCREEN_ROOT": "${PLUGIN_ROOT}/.."
      }
    }
  }
}
